{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/cursor_python.cmd\" \"${CURSOR_PLUGIN_ROOT}/scripts/cursor_session_start.py\"",
        "timeout": 20
      }
    ],
    "workspaceOpen": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/cursor_python.cmd\" \"${CURSOR_PLUGIN_ROOT}/scripts/cursor_hook.py\"",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/cursor_python.cmd\" \"${CURSOR_PLUGIN_ROOT}/scripts/cursor_hook.py\"",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/cursor_python.cmd\" \"${CURSOR_PLUGIN_ROOT}/scripts/cursor_guard.py\"",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/cursor_python.cmd\" \"${CURSOR_PLUGIN_ROOT}/scripts/cursor_observer.py\"",
        "matcher": "Shell|Write|Task|SwitchMode|CreatePlan|ExitPlanMode|EnterPlanMode",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/cursor_python.cmd\" \"${CURSOR_PLUGIN_ROOT}/scripts/cursor_observer.py\"",
        "matcher": "Shell|Write|Task|SwitchMode|CreatePlan|ExitPlanMode|EnterPlanMode",
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/cursor_python.cmd\" \"${CURSOR_PLUGIN_ROOT}/scripts/cursor_observer.py\"",
        "timeout": 5
      }
    ],
    "afterShellExecution": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/cursor_python.cmd\" \"${CURSOR_PLUGIN_ROOT}/scripts/cursor_observer.py\"",
        "timeout": 5
      }
    ],
    "preCompact": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/cursor_python.cmd\" \"${CURSOR_PLUGIN_ROOT}/scripts/cursor_hook.py\"",
        "timeout": 15
      }
    ],
    "subagentStop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/cursor_python.cmd\" \"${CURSOR_PLUGIN_ROOT}/scripts/cursor_observer.py\"",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/scripts/cursor_python.cmd\" \"${CURSOR_PLUGIN_ROOT}/scripts/cursor_stop.py\"",
        "timeout": 10,
        "loop_limit": 5
      }
    ]
  }
}

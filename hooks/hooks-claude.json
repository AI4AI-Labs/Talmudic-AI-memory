{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/talmudic_hook.py\"",
            "windows": "py -3 \"${CLAUDE_PLUGIN_ROOT}\\scripts\\talmudic_hook.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/talmudic_guard.py\"",
            "windows": "py -3 \"${CLAUDE_PLUGIN_ROOT}\\scripts\\talmudic_guard.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/talmudic_observer.py\"",
            "windows": "py -3 \"${CLAUDE_PLUGIN_ROOT}\\scripts\\talmudic_observer.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|Task|ExitPlanMode|EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/talmudic_observer.py\"",
            "windows": "py -3 \"${CLAUDE_PLUGIN_ROOT}\\scripts\\talmudic_observer.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/talmudic_observer.py\"",
            "windows": "py -3 \"${CLAUDE_PLUGIN_ROOT}\\scripts\\talmudic_observer.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/talmudic_hook.py\"",
            "windows": "py -3 \"${CLAUDE_PLUGIN_ROOT}\\scripts\\talmudic_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/talmudic_stop.py\"",
            "windows": "py -3 \"${CLAUDE_PLUGIN_ROOT}\\scripts\\talmudic_stop.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/talmudic_hook.py\"",
            "windows": "py -3 \"${CLAUDE_PLUGIN_ROOT}\\scripts\\talmudic_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
